# Copy to .env and fill in. Never commit .env.
# Credentials come from `gcloud auth application-default login`;
# no service account key files are used anywhere.

# GCP project that runs and pays for BigQuery jobs.
GCP_PROJECT_ID=governed-analytics-dev

# Dataset dbt builds models into (location US, same as the public dataset).
BQ_DATASET=thelook_dbt

# Frozen copy of thelook_ecommerce (scripts/snapshot.py); dbt sources read from it.
SNAPSHOT_DATASET=thelook_snapshot

# Service account dbt impersonates. Has write access to BQ_DATASET only.
DBT_IMPERSONATE_SA=dbt-runner@governed-analytics-dev.iam.gserviceaccount.com

# Service account the agent executor impersonates. Read-only.
AGENT_IMPERSONATE_SA=agent-readonly@governed-analytics-dev.iam.gserviceaccount.com

# Runtime environment: dev | test | staging | prod. Required, no default.
ENV=dev
# Trust X-User / X-Role headers instead of OIDC. The app refuses to start if
# this is true and ENV is anything other than dev.
DEV_AUTH_STUB=false

# Local Postgres (docker compose). Port 5433 avoids clashing with a local 5432.
# Use 127.0.0.1, not localhost (localhost can hang on IPv6 on Windows).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=governed_analytics

# Model provider.
ANTHROPIC_API_KEY=
PRIMARY_MODEL=claude-sonnet-5-5
# Placeholder for Phase 4 routing; not used yet.
SMALL_MODEL=claude-haiku-5-5

# Workflow budgets. MAX_REPAIRS is 0-3 (0 = no repair, for baselines).
MAX_REPAIRS=3
MAX_MODEL_CALLS=6
REQUEST_BUDGET_S=30
BQ_TIMEOUT_S=20
MAX_BYTES_BILLED=2000000000
ROW_LIMIT=1000

# Fixed "today" (YYYY-MM-DD) for reproducible relative-time eval questions.
# Leave empty outside eval runs.
EVAL_REFERENCE_DATE=
